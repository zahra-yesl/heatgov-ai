# HeatGov AI — environment variables
# FortyGuard Hackathon 2026
# Authors: Zahra Yeslek and Mariem Elbechir
#
# Copy this file to `.env` (same folder) and fill in your real keys.
# `.env` is git-ignored and must never be committed. See SECURITY.md.

# FortyGuard Temperature API
# Sign up: https://docs-api.fortyguard.com/docs
# Required by: backend/data_pipeline/*  (heatmaps, environmental parameters)
FORTYGUARD_API_KEY=your_fortyguard_key_here
FORTYGUARD_BASE_URL=https://api.fortyguard.com

# Google Gemini
# Free key: https://aistudio.google.com/apikey
# Required by: backend/agent/*  (the conversational agent and its tools)
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-3.6-flash

# Optional: a pool of Gemini keys, comma-separated, no spaces.
# The free tier limits requests per minute PER KEY. When one is exhausted the
# agent rotates to the next instead of failing. Leave blank to use the single
# GEMINI_API_KEY above.
# GEMINI_API_KEYS=key_one,key_two,key_three

# US Census Bureau API
# Free key, emailed within a minute: https://api.census.gov/data/key_signup.html
# Required by: backend/data_pipeline/fetch_census.py
# Not optional - a keyless request returns an HTML "Missing Key" page with
# HTTP 200 rather than an error, which is easy to mistake for valid data.
CENSUS_API_KEY=your_census_key_here

# ---------------------------------------------------------------------------
# DEPLOYMENT ONLY - not needed to run locally. See docs/DEPLOYMENT.md.
# ---------------------------------------------------------------------------

# Extra browser origins allowed to call the API, comma-separated.
# localhost:3000 and 127.0.0.1:3000 are always allowed, and *.vercel.app is
# matched by a pattern, so this is only for a custom domain.
# Set it in the Render dashboard, not in a committed file.
# ALLOWED_ORIGINS=https://heatgov-ai.example.org

# Where the front end looks for the API. This one belongs to the FRONT END and
# is set in the Vercel dashboard (or frontend/.env.local for a local override),
# NOT in this file - the backend never reads it.
# Next.js inlines it at build time, so changing it needs a redeploy.
# NEXT_PUBLIC_API_URL=https://heatgov-ai-backend.onrender.com
